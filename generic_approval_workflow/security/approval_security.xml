<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Approval Category -->
        <record id="module_category_approval" model="ir.module.category">
            <field name="name">Approvals</field>
            <field name="description">Configurable approval workflows</field>
            <field name="sequence">20</field>
        </record>

        <!-- Approval User -->
        <record id="group_approval_user" model="res.groups">
            <field name="name">Approval User</field>
            <field name="category_id" ref="module_category_approval"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Can act on the approvals assigned to them and read the history.
            </field>
        </record>

        <!-- Approval Administrator -->
        <record id="group_approval_manager" model="res.groups">
            <field name="name">Approval Administrator</field>
            <field name="category_id" ref="module_category_approval"/>
            <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
            <field name="comment">
                Can configure approval workflows and stages.
            </field>
        </record>

        <!-- Approval History Multi Company -->
        <record id="approval_history_company_rule" model="ir.rule">
            <field name="name">Approval History multi-company</field>
            <field name="model_id" ref="model_approval_history"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <!-- Approval Workflow Multi Company -->
        <record id="approval_workflow_company_rule" model="ir.rule">
            <field name="name">Approval Workflow multi-company</field>
            <field name="model_id" ref="model_approval_workflow"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>