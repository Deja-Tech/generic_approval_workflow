<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="approval_action_wizard_view_form" model="ir.ui.view">
            <field name="name">approval.action.wizard.form</field>
            <field name="model">approval.action.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="action_type" invisible="1"/>
                        <field name="comment_required" invisible="1"/>
                        <field name="comment" nolabel="1" required="comment_required"
                               placeholder="Reason ..."/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Discard" class="btn-secondary" special="cancel"
                                data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
